# ==============================================================================
# Backend API Environment Variables Example (.env)
# ==============================================================================

# ─── Application Configuration ────────────────────────────────────────────────
PORT=8000
NODE_ENV=development

# ─── PostgreSQL & Prisma Database URL ─────────────────────────────────────────
# For Local Host Machine:
DATABASE_URL=postgresql://app_user:app_PASSWORD@localhost:5432/app_db

# For Docker Compose (service name "postgres"):
# DATABASE_URL=postgresql://app_user:app_PASSWORD@postgres:5432/app_db

# Database Credentials
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_PASSWORD
POSTGRES_DB=app_db

# ─── Redis Cache, Sessions & Realtime Pub/Sub ─────────────────────────────────
# For Local Host Machine:
REDIS_URL=redis://localhost:6379

# For Docker Compose:
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_URL=redis://redis:6379

# ─── Authentication & Security ────────────────────────────────────────────────
# Secret key used for signing JWT tokens
JWT_SECRET=super_secret_jwt_signing_key_replace_with_secure_random_string
JWT_EXPIRES_IN=24h

# ─── SMS Service Provider ─────────────────────────────────────────────────────
# API Key for SMS OTP verification (e.g. Kavenegar or test key)
SMS_KEY=your_sms_provider_api_key_here
