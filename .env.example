# ==============================================================================
# TaskFlow / Jira Clone - Root Docker Compose Environment Example (.env)
# ==============================================================================
# Copy this file to .env at the root of the project to customize Docker settings

# ─── Service Ports ────────────────────────────────────────────────────────────
API_PORT=5000
CLIENT_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ─── PostgreSQL Database Configuration ────────────────────────────────────────
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_PASSWORD
POSTGRES_DB=app_db
DATABASE_URL=postgresql://app_user:app_PASSWORD@postgres:5432/app_db

# ─── Redis Cache & Realtime Configuration ─────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ─── Security & Authentication ────────────────────────────────────────────────
JWT_SECRET=super_secret_jwt_signing_key_replace_with_secure_random_string
JWT_EXPIRES_IN=24h

# ─── SMS Service Provider ─────────────────────────────────────────────────────
SMS_KEY=your_sms_provider_api_key_here
