# ==============================================================================
# Frontend Client Environment Variables Example (.env)
# ==============================================================================

# Backend REST API Prefix or Base URL
# In local development with Vite proxy, use '/api'
# In standalone production, use 'http://localhost:8000/api' or your API domain
VITE_API_URL=/api

# Backend Host URL (used by Vite dev proxy in vite.config.js)
VITE_BACKEND_URL=http://localhost:8000

# WebSocket / Socket.IO Server Endpoint
VITE_SOCKET_URL=http://localhost:8000
